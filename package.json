{
  "name": "flames-mern-app",
  "version": "1.0.0",
  "description": "FLAMES Game Web Application - MERN Stack",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "dev:backend": "npm run --prefix server dev",
    "dev:frontend": "npm run --prefix client dev",
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "install:client": "npm --prefix client install",
    "install:server": "npm --prefix server install",
    "build": "npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "start:server": "npm --prefix server start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": ["flames", "game", "mern", "react", "express", "mongodb"],
  "author": "FLAMES App Team",
  "license": "MIT"
}
