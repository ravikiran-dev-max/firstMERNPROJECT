# ==============================================================
# FLAMES Backend Environment Variables (Render & Local Deployment)
# ==============================================================

# Server Port (Render sets this automatically; defaults to 5000 locally)
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=production

# MongoDB Connection String
# For MongoDB Atlas (Recommended on Render):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/flames_game?retryWrites=true&w=majority
# For Local Development:
MONGODB_URI=mongodb://127.0.0.1:27017/flames_game

# Secret Admin Key (Used by Admin Panel at /admin)
ADMIN_SECRET_KEY=flamesadmin2026

# Allowed Frontend Client Origin(s) for CORS (can be comma-separated or *)
# Example: https://your-flames-app.vercel.app,http://localhost:5173
CLIENT_ORIGIN=https://your-flames-app.vercel.app
